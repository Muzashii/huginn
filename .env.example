# Copie para .env e preencha. O .env NUNCA vai para o Git.

# --- Banco ---
POSTGRES_USER=huginn
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=huginn
POSTGRES_PORT=5433

# --- n8n ---
N8N_VERSION=1.97.1
# gere com: python -c "import secrets; print(secrets.token_hex(24))"
N8N_ENCRYPTION_KEY=
# URL pública HTTPS do túnel (cloudflared/ngrok). O Telegram exige HTTPS.
N8N_WEBHOOK_URL=http://localhost:5678/

# --- Telegram ---
# id do grupo de atendimento humano (número negativo, ex.: -1001234567890)
ATENDIMENTO_CHAT_ID=0
# O token do bot vai nas Credentials do n8n, não aqui.

# --- Base de conhecimento ---
DRIVE_PASTA_BASE_ID=
EMBEDDINGS_MODEL=nomic-embed-text
EMBEDDINGS_DIM=768
OLLAMA_URL=http://127.0.0.1:11434

# --- Brokk (ferramenta de orçamento) ---
BROKK_API_URL=http://brokk-mock:8090

# --- LGPD ---
RETENCAO_DIAS=90

# --- Avaliação (eval/avaliar.py, roda fora do Docker) ---
EVAL_WEBHOOK_URL=http://127.0.0.1:5678/webhook/huginn-eval
EVAL_TOKEN=
DATABASE_URL=postgresql://huginn:troque-esta-senha@127.0.0.1:5433/huginn?connect_timeout=10
# LLM-juiz de fidelidade (opcional; sem chave a métrica fica "n/d")
ANTHROPIC_API_KEY=
JUIZ_MODELO=claude-haiku-5-5
# preço em US$ por milhão de tokens do modelo do W2 (Claude Haiku 5.5), para o custo por conversa
PRECO_ENTRADA_MTOK=0.10
PRECO_SAIDA_MTOK=0.50
